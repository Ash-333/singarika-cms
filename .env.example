# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/singarika?schema=public"

# NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="singarika"

# Public API
PUBLIC_API_CORS_ORIGIN="*"

# Seed admin (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@singarika.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Store Admin"
